# ── Public surface whitelist ────────────────────────────────────────────
# This repository publishes only the buildable app plus README, LICENSE,
# notices, and screenshots. Everything else (engineering docs, decisions,
# changelog, the T012 instrumentation subsystem, and internal scripts) is
# kept local / in a private companion repo and must not be pushed here.
# Verify with: git ls-files  and a fresh-clone `./gradlew assembleDebug`.
/*
!/.gitignore
!/README.md
!/README.ko.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/docs
!/build.gradle
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle
!/app
!/assets
!/fastlane
# ReteKey G (Gboard-style fork): CI workflow, build scripts and the built APKs
!/.github
!/scripts
!/release
!/NOTICE

# gradle/: wrapper only
/gradle/*
!/gradle/wrapper

# docs/: the public manuals only (Markdown)
/docs/*
!/docs/*.md
# docs/fdroid/: the F-Droid recipe, kept beside the build it drives
!/docs/fdroid

# app/: build script, R8 rules, main sources, and JVM unit tests only
/app/*
!/app/build.gradle
!/app/proguard-rules.pro
!/app/src
/app/src/*
!/app/src/main
!/app/src/test

# never track build outputs or local config
build/
.gradle/
.idea/
local.properties
*.apk
*.aab
.claude/

# agy-only customization layer (local; see rootsator RFC-0001)
/.agents/

# ReteKey G: the built APKs are published in release/ on purpose
!/release/*.apk
# never the signing key or its passwords
/signing/
keystore.properties
*.keystore
*.jks
build-nogradle/

# apksigner v4 (incremental install) signatures are not published
*.idsig

# never any other key material, credential or local environment file
*.p12
*.pem
*.key
*.pfx
.env
.env.*
*.base64.txt
